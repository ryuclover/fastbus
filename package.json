{
  "name": "fastbus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-cloud-worker.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/build-traces.mjs",
    "start": "next start",
    "lint": "npm run typecheck",
    "map:clickbus": "tsx lib/scrapers/clickbus/mapper.ts",
    "map:gontijo": "tsx lib/scrapers/gontijo/mapper.ts",
    "map:guanabara": "tsx lib/scrapers/guanabara/mapper.ts",
    "map:buser": "tsx lib/scrapers/buser/mapper.ts",
    "compare:interval": "tsx scripts/test-interval-search.ts",
    "worker": "tsx scripts/worker.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx scripts/verify-e2e.ts",
    "format:check": "prettier --check app/page.tsx app/fastbus.css lib/server lib/monitoring tests scripts/worker.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.227.3",
    "@libsql/client": "^0.18.0",
    "@radix-ui/react-slot": "1.2.4",
    "@sparticuz/chromium": "^152.0.0",
    "@vercel/blob": "^2.8.2",
    "@vercel/sandbox": "^3.9.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.564.0",
    "next": "^16.4.3",
    "playwright-core": "^1.63.0",
    "puppeteer": "^25.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.23.1",
    "undici": "^7.30.1",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  }
}
